# Docker Compose local configuration. Copy this file to .env and replace the
# placeholder with a password used only on your laptop.
POSTGRES_DB=releaseguard
POSTGRES_USER=releaseguard
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
RELEASEGUARD_DATABASE_URL=postgresql+psycopg://releaseguard:CHANGE_ME_LOCAL_ONLY@database:5432/releaseguard

# Optional host-port overrides.
FRONTEND_PORT=5173
BACKEND_PORT=8000
