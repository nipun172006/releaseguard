# Copy this file to terraform.tfvars only when you need to override a default.
# This file contains configuration values, never AWS access keys or passwords.

aws_region         = "ap-south-1"
project_name       = "releaseguard"
environment        = "dev"
cluster_name       = "releaseguard-eks"
kubernetes_version = "1.35"

availability_zones  = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs  = ["10.20.1.0/24", "10.20.2.0/24"]

node_instance_type = "m7i-flex.large"
node_min_size      = 1
node_desired_size  = 1
node_max_size      = 2
